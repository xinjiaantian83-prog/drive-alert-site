{
  "name": "shikoku-traffic-watch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "STATIC_EXPORT=1 next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "sync": "tsx scripts/sync.ts",
    "sync:scheduled": "node scripts/scheduled-sync.mjs",
    "api:export": "tsx scripts/export-cloud-api.ts",
    "db:seed": "tsx scripts/seed-database.ts",
    "sync:cloud": "npm run db:seed && npm run sync && npm run report:nationwide && npm run api:export",
    "simulate": "tsx scripts/simulate-notifications.ts",
    "ios:data": "tsx scripts/export-ios-data.ts",
    "ios:generate": "xcodegen generate --spec ios/project.yml",
    "ios:build": "xcodebuild -project ios/OfficialTrafficWatch.xcodeproj -scheme OfficialTrafficWatch -sdk iphonesimulator -configuration Debug CODE_SIGNING_ALLOWED=NO build"
    ,"report:nationwide": "tsx scripts/nationwide-report.ts",
    "audit:two-step": "tsx scripts/audit-two-step-pdfs.ts"
    ,"audit:pdf-layouts": "tsx scripts/audit-pdf-layouts.ts",
    "audit:html-sources": "tsx scripts/audit-html-sources.ts"
    ,"store:validate": "node scripts/validate-store-submission.mjs",
    "store:ios-screenshots": "./scripts/generate-ios-screenshots.sh",
    "store:android-screenshots": "./scripts/generate-android-screenshots.sh",
    "store:graphics": "./scripts/generate-store-graphics.sh"
    ,"check:links": "node scripts/check-static-links.mjs"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "next": "^15.5.3",
    "pdf-parse": "^1.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "leaflet": "^1.9.4",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.5.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
